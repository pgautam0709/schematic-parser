# ── LLM Provider ────────────────────────────────────────────────────────────
# Choose which LLM backend to use: "azure" or "gcp"
# Leave blank or unset to disable LLM enrichment entirely.
LLM_PROVIDER=azure

# ── Azure OpenAI (LLM_PROVIDER=azure) ───────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-05-01-preview

# ── Google Cloud Vertex AI (LLM_PROVIDER=gcp) ───────────────────────────────
# Authentication: set GOOGLE_APPLICATION_CREDENTIALS to a service account key
# file, OR leave unset and use Application Default Credentials
# (run: gcloud auth application-default login)
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_MODEL=gemini-2.0-flash
# GCP_MODEL=gemini-1.5-pro          # alternative — higher quality, slower
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ── Pipeline tuning ─────────────────────────────────────────────────────────
# Pages with spatial confidence below this threshold trigger LLM enrichment.
CONFIDENCE_THRESHOLD=0.65

# Number of pages sent per LLM API call (keeps token counts manageable).
LLM_BATCH_SIZE=5
